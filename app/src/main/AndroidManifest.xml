<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Basemap tiles (one-off downloads for offline regions) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- GPS track recording -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Installing a downloaded update over this copy of the app. This only lets the
        request be made: Android still asks the operator to confirm every time, and an APK
        signed with a different key is refused by the installer whatever this says.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The app is fully usable without a GPS chip (tracks can be drawn/imported) -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:name=".SprayDayApplication"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SprayDay">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SprayDay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Location-typed foreground service. Only started from the visible UI,
            which is why ACCESS_BACKGROUND_LOCATION is not needed.
        -->
        <service
            android:name=".tracking.TrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!--
            Receives the installer's answer to a committed update session. Declared here
            rather than registered by the screen that started it, because the answer can
            arrive after this app's process has been replaced.
        -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />
    </application>

</manifest>
