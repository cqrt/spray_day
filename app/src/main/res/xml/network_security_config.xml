<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext HTTP is refused by default on modern Android, but the map's tiles
    are served by the app's own tile server on loopback. This permits cleartext
    for loopback only, and nothing else.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
